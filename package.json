{
  "name": "youtube-automation",
  "version": "1.0.0",
  "description": "Free, token-free daily YouTube pipeline: script -> voice -> visuals -> upload",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node orchestrator.js",
    "dry-run": "node orchestrator.js --dry-run",
    "auth:youtube": "node scripts/get-youtube-refresh-token.js",
    "growth:report": "node scripts/channel-growth-report.mjs",
    "growth:fix-channel": "node scripts/fix-channel-growth.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.487",
    "@remotion/cli": "^4.0.487",
    "@remotion/renderer": "^4.0.487",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.9.3",
    "googleapis": "^144.0.0",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.487",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.21.0": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true
  }
}
