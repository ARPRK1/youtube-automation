# Free-tier LLM for script writing (set at least one). Never Claude/Anthropic here.
GROQ_API_KEY=
GEMINI_API_KEY=

# YouTube Data API v3 upload credentials (see README.md + scripts/get-youtube-refresh-token.js)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=unlisted

# Optional: free Pexels API key for stock-photo backgrounds (falls back to
# generated gradients if unset).
PEXELS_API_KEY=

# Optional overrides
DAILY_LONG_COUNT=2
DAILY_SHORT_COUNT=4
TTS_VOICE=en-US-AndrewNeural
