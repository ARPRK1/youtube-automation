# --- Free-tier LLM (script writing + topic scoring + vision). Never Claude. ---
# At least one is required. Add GROQ_API_KEY_2, _3, … for more free quota —
# the pipeline round-robins across them. Vision (relevance + never-people)
# also uses these; keep at least one set or those checks degrade open.
GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=

# --- YouTube Data API v3 upload (see README + scripts/get-youtube-refresh-token.js) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Channel lock: upload refuses to publish to any other channel this token is
# bound to. Set to the ModernMonk channel id.
YOUTUBE_CHANNEL_ID=UCv8n_ykbynzj6-gwdwX6loA
YOUTUBE_CHANNEL_HANDLE=modernmonkshot
# Public is required for the algorithm / YPP watch hours. Override ONLY for
# testing; the default in config.yaml is already public.
YOUTUBE_PRIVACY_STATUS=public

# --- Optional: free stock-media keys for real b-roll (falls back to Wikimedia/
#     Openverse + AI generation if unset). ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Note: video counts, voice provider, pillars, region, and all other behavior
# are controlled from config.yaml — not env vars. (The old DAILY_LONG_COUNT /
# DAILY_SHORT_COUNT / TTS_VOICE variables are no longer read.)
